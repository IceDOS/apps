+// Fallback for a wl_client whose parent chain no longer reaches its reaper: read the
+// AppId the game exports for itself, as the STEAM_GAME atom does for Xwayland.
+uint32_t
+get_appid_from_pid_env( pid_t pid )
+{
+	char filename[256];
+	snprintf( filename, sizeof( filename ), "/proc/%i/environ", pid );
+
+	std::ifstream proc_environ_file( filename );
+	if ( !proc_environ_file.is_open() )
+		return 0;
+
+	std::string entry;
+	while ( std::getline( proc_environ_file, entry, '\0' ) )
+	{
+		uint32_t unAppId = 0;
+		if ( sscanf( entry.c_str(), "SteamAppId=%u", &unAppId ) == 1 && unAppId != 0 )
+			return unAppId;
+	}
+
+	return 0;
+}
