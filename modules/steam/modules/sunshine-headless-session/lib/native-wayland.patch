+		// A Wayland client waits on its subsurface's frame callback; without this it
+		// presents one frame and blocks forever.
+		if ( w->type == steamcompmgr_win_type_t::XDG )
+		{
+			wlr_surface *content_surface = w->xdg().surface.content_surface.load();
+
+			if ( content_surface != nullptr && content_surface != main_surface && content_surface != current_surface )
+			{
+				wlserver_send_frame_done( content_surface, &now );
+			}
+		}
+
 		wlserver_unlock();
 	}
 }
