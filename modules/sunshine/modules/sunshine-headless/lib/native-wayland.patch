+// Native Wayland clients render into a subsurface over a blank toplevel; gamescope tracks
+// one surface per window, so attribute subsurface content to its root's window.
+static struct wlr_surface *subsurface_root_surface( struct wlr_surface *pSurface )
+{
+	struct wlr_surface *pRoot = pSurface;
+
+	for ( int i = 0; i < 32; i++ )
+	{
+		struct wlr_subsurface *pSubsurface = wlr_subsurface_try_from_wlr_surface( pRoot );
+		if ( !pSubsurface || !pSubsurface->parent )
+			break;
+
+		pRoot = pSubsurface->parent;
+	}
+
+	return pRoot;
+}
+
+// Wine backs every HWND with a surface, so last-commit-wins picks the wrong one.
+// Keep the largest.
+static bool wlserver_xdg_pick_content_surface( struct wlserver_xdg_surface_info *pXdgInfo, struct wlr_surface *pSurface, struct wlr_buffer *pBuffer )
+{
+	const uint64_t ulWidth = pBuffer->width > 0 ? uint64_t( pBuffer->width ) : 0;
+	const uint64_t ulHeight = pBuffer->height > 0 ? uint64_t( pBuffer->height ) : 0;
+	const uint64_t ulArea = ulWidth * ulHeight;
+
+	// A 1x1 winning would scale to the whole output: a solid-colour screen.
+	if ( ulArea < 64 )
+		return false;
+
+	if ( pXdgInfo->content_surface.load() == pSurface )
+	{
+		pXdgInfo->content_area = ulArea;
+		return true;
+	}
+
+	if ( ulArea <= pXdgInfo->content_area.load() )
+		return false;
+
+	wl_log.infof( "xdg: content surface for window %p is now %p (%dx%d)",
+		(void *)pXdgInfo->win, (void *)pSurface, pBuffer->width, pBuffer->height );
+
+	pXdgInfo->content_surface = pSurface;
+	pXdgInfo->content_area = ulArea;
+	return true;
+}
