+        return false;
+
+    for (auto& user : m_users.user) {
+        if (user.player_index == 1)
+            user.player_index = -1;
+    }
+    it->player_index = 1;
+    return true;
+}
+
 User UserManager::GetDefaultUser() {
     return *GetUserByPlayerIndex(1);
 }
